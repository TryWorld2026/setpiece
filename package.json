{
  "name": "tryworld-set-monorepo",
  "private": true,
  "description": "TryWorld Set: an open source AI video studio. The `@tryworld/set` package (the format, the `twset` CLI and Studio), the desktop app, and what the clients share.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @tryworld/set dev",
    "dev:desktop": "pnpm --filter @tryworld/set-desktop start",
    "build": "pnpm --filter @tryworld/set build:ui && pnpm --filter @tryworld/set-desktop build:shell",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "twset": "node packages/openfilm/bin/twset.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "changeset": "changeset",
    "examples:sync": "node scripts/sync-examples.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.31.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=9 <11": "11.0.4",
      "zod@>=4 <4.6.6": "^4.6.6",
      "undici@>=8 <8.12.2": "^8.12.2"
    }
  }
}
