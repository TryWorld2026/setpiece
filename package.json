{
  "name": "setpiece-monorepo",
  "private": true,
  "description": "Setpiece · 造境: an Apple-inspired AI film workspace. A commercial derivative of OpenFilm, with the film format, `setpiece` CLI and Studio, the desktop app, and what the clients share.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @tryworld/setpiece dev",
    "dev:desktop": "pnpm --filter setpiece-desktop start",
    "build": "pnpm --filter @tryworld/setpiece build:ui && pnpm --filter setpiece-desktop build:shell",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "setpiece": "node packages/openfilm/bin/twset.mjs",
    "twset": "node packages/openfilm/bin/twset.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "changeset": "changeset",
    "examples:sync": "node scripts/sync-examples.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.31.1"
  },
  "pnpm": {
    "packageExtensions": {
      "app-builder-lib@26.15.3": {
        "peerDependenciesMeta": {
          "electron-builder-squirrel-windows": {
            "optional": true
          }
        }
      }
    },
    "overrides": {
      "@electron/asar": "4.3.1",
      "@electron/universal": "3.0.6",
      "glob@>=13 <14.1": "14.0.2",
      "jake": "13.0.3",
      "minimatch@>=9 <11": "11.0.4",
      "zod@>=4 <4.6.6": "^4.6.6",
      "undici@>=8 <8.12.2": "^8.12.2"
    }
  }
}
