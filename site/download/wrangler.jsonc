{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setpiece-download",
  "account_id": "d59de4a1d41cd3bfce2ce0c459cfe359",
  "compatibility_date": "2026-11-03",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "setpiece.tryworld.com.cn",
      "custom_domain": true
    },
    {
      "pattern": "set.tryworld.com.cn",
      "custom_domain": true
    }
  ]
}
